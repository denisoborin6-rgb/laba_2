public class Task3 {

    private Task1 name;
    private int height;
    private Task3 father;

    public Task3(Task1 name, int height) {
        this(name, height, null);
    }

    public Task3(Task1 name, int height, Task3 father) {
        this.name = name;
        this.height = height;
        this.father = father;
    }

    public Task1 getName()   { return name; }
    public int getHeight()   { return height; }
    public Task3 getFather() { return father; }

    private String resolveSurname() {
        if (name.getSurname() != null) return name.getSurname();
        if (father != null && father.getName().getSurname() != null)
            return father.getName().getSurname();
        return null;
    }

    private String resolvePatronymic() {
        if (name.getPatronymic() != null) return name.getPatronymic();
        if (father != null && father.getName().getFirstName() != null)
            return father.getName().getFirstName() + "ович";
        return null;
    }

    @Override
    public String toString() {
        StringBuilder sb = new StringBuilder();
        String s = resolveSurname();
        String f = name.getFirstName();
        String p = resolvePatronymic();

        if (s != null) sb.append(s);
        if (f != null) { if (sb.length() > 0) sb.append(" "); sb.append(f); }
        if (p != null) { if (sb.length() > 0) sb.append(" "); sb.append(p); }

        return sb + ", рост " + height;
    }

    // Возвращает строку с результатом задания 3
    public static String run() {
        Task3 boris = new Task3(new Task1("Борис"), 180);
        Task3 peter = new Task3(new Task1("Чудов", "Пётр"), 175, boris);
        Task3 ivan  = new Task3(new Task1("Чудов", "Иван"), 170, peter);

        StringBuilder sb = new StringBuilder();
        sb.append("Иван:  ").append(ivan).append("\n");
        sb.append("Пётр:  ").append(peter).append("\n");
        sb.append("Борис: ").append(boris).append("\n");
        return sb.toString();
    }
}




public class Task4 {

    // Вложенный класс Точка
    public static class Point {
        private int x;
        private int y;

        public Point(int x, int y) {
            this.x = x;
            this.y = y;
        }

        public Point() {
            this(0, 0);
        }

        public int getX() { return x; }
        public int getY() { return y; }

        public void shift(int dx, int dy) {
            this.x += dx;
            this.y += dy;
        }

        @Override
        public String toString() {
            return "(" + x + ";" + y + ")";
        }
    }

    // Вложенный класс Ломаная
    public static class Polyline {
        private Point[] points;

        public Polyline() {
            this.points = new Point[0];
        }

        public Polyline(Point... points) {
            this.points = (points == null) ? new Point[0] : points;
        }

        public Point[] getPoints() { return points; }
        public Point getPoint(int i) { return points[i]; }
        public void setPoints(Point[] v) { this.points = (v == null) ? new Point[0] : v; }
        public int size() { return points.length; }

        public void addPoints(Point... newPoints) {
            if (newPoints == null || newPoints.length == 0) return;
            Point[] res = new Point[points.length + newPoints.length];
            System.arraycopy(points, 0, res, 0, points.length);
            System.arraycopy(newPoints, 0, res, points.length, newPoints.length);
            this.points = res;
        }

        public double length() {
            double sum = 0;
            for (int i = 0; i < points.length - 1; i++) {
                int dx = points[i + 1].getX() - points[i].getX();
                int dy = points[i + 1].getY() - points[i].getY();
                sum += Math.sqrt(dx * dx + dy * dy);
            }
            return sum;
        }

        @Override
        public String toString() {
            StringBuilder sb = new StringBuilder("Линия [");
            for (int i = 0; i < points.length; i++) {
                if (i > 0) sb.append(",");
                sb.append(points[i]);
            }
            return sb.append("]").toString();
        }
    }

    // Возвращает строку с результатом задания 4
    public static String run() {
        Point p1 = new Point(1, 5);
        Point p2 = new Point(2, 8);
        Point p3 = new Point(5, 3);
        Point p4 = new Point(2, -5);
        Point p5 = new Point(4, -8);

        Polyline first  = new Polyline(p1, p2, p3);
        Polyline second = new Polyline(p1, p4, p5, p3);

        StringBuilder sb = new StringBuilder();
        sb.append("Первая ломаная: ").append(first).append("\n");
        sb.append("Вторая ломаная: ").append(second).append("\n");

        first.getPoint(0).shift(10, 10);

        sb.append("После сдвига начала первой ломаной на (10, 10):\n");
        sb.append("Первая ломаная: ").append(first).append("\n");
        sb.append("Вторая ломаная: ").append(second).append("\n");
        return sb.toString();
    }
}




